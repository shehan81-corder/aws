
#!/bin/bash

echo "Delete bucket and its contents"

# Stop on undefined variables
set -u

# Check bucket name
BUCKET_NAME="${1:?Usage: bash delete-bucket-and-objects BUCKET_NAME}"

# Resolve the directory where this script lives
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# First, try deleting the bucket
if response=$(bash "$SCRIPT_DIR/delete-bucket" "$BUCKET_NAME" 2>&1); then
    echo "Bucket deleted."

else
    error_code=$?

    if [[ "$response" == *"(BucketNotEmpty)"* ]]; then
        echo "Bucket is not empty. Removing its objects..."

        # Delete all objects
        if response=$(bash "$SCRIPT_DIR/delete-objects" "$BUCKET_NAME" 2>&1); then
            echo "Objects deleted successfully."

            # Try deleting the bucket again
            if response=$(bash "$SCRIPT_DIR/delete-bucket" "$BUCKET_NAME" 2>&1); then
                echo "Bucket deleted."
            else
                echo "Failed to delete bucket: $response" >&2
                exit $?
            fi

        else
            error_code=$?
            echo "Could not empty the bucket: $response" >&2
            exit "$error_code"
        fi

    else
        echo "Failed to delete bucket: $response" >&2
        exit "$error_code"
    fi
fi
